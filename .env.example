# Audiobook Organizer configuration.
#
# Copy this to .env and edit, or just launch the app and use the Settings page (F12),
# which reads and writes that same file. Every key below is also a control in the GUI,
# on the tab named in the section headings.
#
# .env is gitignored - never commit real keys.
#
# Values resolve in this order:  process environment  >  .env  >  built-in default.
# The defaults shown here are the built-in ones, so a key you delete keeps working.


# ============================================================================
# General  (Settings > General)
# ============================================================================

# Both are empty by default, and deliberately so: a default of "input" quietly points
# a fresh install at a folder inside the program directory, the first scan appears to
# work and finds nothing, and nobody is ever asked. Empty means unset - the window says
# so and links to the Settings page. Absolute, or relative to this folder.
AO_INPUT_DIR=
AO_OUTPUT_DIR=

# Console log verbosity: DEBUG | INFO | WARNING | ERROR.
# The rolling file log is always written to audiobook_organizer.log in this folder.
AO_LOG_LEVEL=DEBUG

# Parallel workers for lookups.
AO_THREADS=4


# ============================================================================
# LLM providers  (Settings > Providers)
# ============================================================================

# The active provider - a name from AO_PROVIDERS below.
AO_PROVIDER=sanctum
AO_TEMPERATURE=0.1
AO_MAX_TOKENS=2048
# HTTP timeout in seconds, and retries per failed call (exponential backoff).
AO_TIMEOUT=120
AO_MAX_RETRIES=3

# Any endpoint speaking the OpenAI chat-completions format works. To add one, append
# its name here and define AO_PROVIDER_<NAME>_BASE_URL / _API_KEY / _MODEL below.
# Optional per-provider keys: _AUTH_STYLE (bearer|x-api-key|none), _EXTRA_BODY (JSON
# merged into every request), _SUPPORTS_JSON_MODE, _SUPPORTS_SEED.
AO_PROVIDERS=sanctum,openai,groq,openrouter,mistral,anthropic,ollama,lmstudio

# Sanctum - a provider-agnostic gateway; the model id routes to whatever backend the
# admin configured. No base URL is shipped: it is a private address on somebody's
# network, so it is a field you fill in, like the key.
AO_PROVIDER_SANCTUM_BASE_URL=
AO_PROVIDER_SANCTUM_API_KEY=
AO_PROVIDER_SANCTUM_MODEL=__free_priority__/any_free_in_priority
AO_PROVIDER_SANCTUM_AUTH_STYLE=bearer
AO_PROVIDER_SANCTUM_EXTRA_BODY={"enable_tools": false}

AO_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
AO_PROVIDER_OPENAI_API_KEY=
AO_PROVIDER_OPENAI_MODEL=gpt-4o-mini

AO_PROVIDER_GROQ_BASE_URL=https://api.groq.com/openai/v1
AO_PROVIDER_GROQ_API_KEY=
AO_PROVIDER_GROQ_MODEL=llama-3.3-70b-versatile

AO_PROVIDER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AO_PROVIDER_OPENROUTER_API_KEY=
AO_PROVIDER_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

AO_PROVIDER_MISTRAL_BASE_URL=https://api.mistral.ai/v1
AO_PROVIDER_MISTRAL_API_KEY=
AO_PROVIDER_MISTRAL_MODEL=ministral-8b-latest
AO_PROVIDER_MISTRAL_SUPPORTS_SEED=false

AO_PROVIDER_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
AO_PROVIDER_ANTHROPIC_API_KEY=
AO_PROVIDER_ANTHROPIC_MODEL=claude-sonnet-4-5
AO_PROVIDER_ANTHROPIC_SUPPORTS_SEED=false
AO_PROVIDER_ANTHROPIC_SUPPORTS_JSON_MODE=false

AO_PROVIDER_OLLAMA_BASE_URL=http://localhost:11434/v1
AO_PROVIDER_OLLAMA_API_KEY=
AO_PROVIDER_OLLAMA_MODEL=llama3.2:3b
AO_PROVIDER_OLLAMA_AUTH_STYLE=none

AO_PROVIDER_LMSTUDIO_BASE_URL=http://localhost:1234/v1
AO_PROVIDER_LMSTUDIO_API_KEY=
AO_PROVIDER_LMSTUDIO_MODEL=
AO_PROVIDER_LMSTUDIO_AUTH_STYLE=none

# Google Books API key. Without one that source cannot be used at all: anonymous
# callers share a project whose daily quota is zero, so every request comes back
# HTTP 429. A key is free from console.cloud.google.com - enable the Books API and
# create an API key.
AO_GOOGLE_BOOKS_KEY=


# ============================================================================
# Identification  (Settings > Identification)
# ============================================================================

# The five tiers, in the order they run. Each fills in only what the earlier ones
# could not.
AO_ENABLE_METADATA=true     # tier 1: tags embedded in the audio files
AO_ENABLE_REGEX=true        # tier 2: author/series/title parsed out of names
AO_ENABLE_API=true          # tier 3: online book databases
AO_ENABLE_SEARCH=true       # tier 4: web search + light page scrape
AO_ENABLE_LLM=true          # tier 5: a language model fills the gaps

# Book databases to query, in order. Available: audnexus (Audible - best series data),
# itunes (Apple Books), googlebooks (widest coverage, patchy series), openlibrary,
# librivox (public domain only).
AO_API_SOURCES=audnexus,itunes,googlebooks,openlibrary,librivox

# How sure an identification must be before searching stops. This is not a filter -
# it is the point at which the tiers stop looking. Lower it to accept looser matches,
# raise it to keep digging.
AO_CONFIDENCE_SCORE=0.80

# Always run at least this many tiers, however confident we already are.
# 1 tags, 2 filenames, 3 book databases, 4 web search, 5 the model.
AO_ALWAYS_SEARCH_TO_TIER=3

# Treat a missing cover image as incomplete data, so the next source is tried for it.
AO_REQUIRE_COVER=false

# Resolve every book in a folder in one LLM call. Cheaper and more accurate - seeing
# "Book 1..Book 4" together is what reveals the shared author and the series name.
AO_FOLDER_REASONING=true

# Auto-approve entries at or above this confidence. 0 disables it.
AO_AUTO_APPROVE_THRESHOLD=0.0

# Flag books that look like ones you already have.
AO_DETECT_DUPLICATES=true

# Flag values that look like a scrape went wrong - an unclosed bracket, a half-stripped
# HTML entity, an author in ALL CAPS - and lower the confidence of the fields involved,
# so they surface for review instead of being applied silently. Nothing is rewritten.
AO_WARN_DIRTY_OUTPUT=true


# ============================================================================
# Output  (Settings > Output)
# ============================================================================

# How Save writes to the output folder.
# ON  = copy: the originals stay where they are, a second copy is written out. Your
#       input library is never touched, at the cost of twice the disk space.
# OFF = move: the files are moved and the input copy is gone. Faster, instant on the
#       same drive, no duplicated data - but the only way back is Undo.
AO_COPY_MODE=true

# Destination folder. Placeholders: {author} {series} {series_index} {title}.
# Empty fields collapse gracefully, so a standalone book does not land in " 00 - Title".
AO_OUTPUT_TEMPLATE={author}/{series} {series_index:02d} - {title}

# Rename the audio files themselves. Off organises the folders only.
AO_RENAME_FILES=true

# Name given to each audio file when renaming is on. Placeholders: {author} {series}
# {series_index} (or {index}) {title} {file_index} {extension}. Any number takes a
# format spec - {series_index:02d} pads to two digits, {file_index:03d} to three. The
# real extension is appended if the template does not end in one.
AO_FILE_TEMPLATE={series} {series_index:02d} - {title} {file_index:03d}

# Also rename the non-audio files that travel with the book - cover art, .epub, .pdf,
# .nfo, .cue, .txt. Only when a file is the only one of its extension in the output
# folder, because two .jpgs renamed to one stem would collide.
AO_RENAME_SUPPORT_FILES=true

# How characters a book title may contain but a filename may not are replaced.
#   smart      - a look-alike per character: ":" -> " -", "/ \ |" -> "-", "< >" -> "( )",
#                '"' -> "'", "*" -> "+", "?" dropped.
#                "Who Goes There? Vol 2: Rising"  ->  "Who Goes There Vol 2 - Rising"
#   dash       - every one of  < > : " / \ | ? *  becomes "-"
#   underscore - all of them become "_"
#   space      - all of them become " "
#   remove     - all of them are deleted
AO_ILLEGAL_CHARS=smart

# What to do when the destination already exists: suffix | skip | merge | overwrite.
AO_COLLISION_POLICY=suffix

# Write corrected metadata back into the audio files, so the organisation survives an
# import into Audiobookshelf, Plex or Prologue - those read tags, not folder names.
AO_WRITE_TAGS=true

# Write metadata.json + .opf next to the book (Audiobookshelf / Calibre).
AO_WRITE_SIDECAR=false


# ============================================================================
# Chapter merging  (Settings > Merging)
# ============================================================================

# Name pattern for a merged .m4b. Empty falls back to AO_FILE_TEMPLATE.
AO_MERGE_TEMPLATE={series} {series_index:02d} - {title}

# Bitrate for the merged file: same | 320k | 256k | 192k | 128k | 96k | 64k | 32k.
# "same" reads the bitrate of the chapter files and encodes at that, so a merge never
# throws quality away. 64k is the usual choice for spoken word.
AO_MERGE_BITRATE=same

# Write the merged .m4b next to the chapter files. Off writes it to the output folder.
AO_MERGE_IN_PLACE=true

# Delete the chapter files once the merge succeeded.
AO_MERGE_DELETE_ORIGINALS=false

# Point the library entry at the merged .m4b afterwards, so it becomes a single-file book.
AO_MERGE_REPLACE_ENTRY=true

# Overwrite an existing .m4b of the same name instead of appending " (2)".
AO_MERGE_OVERWRITE=false

# Path to the ffmpeg executable. Only needed for merging; leave it as "ffmpeg" if
# ffmpeg is on your PATH.
AO_FFMPEG_PATH=ffmpeg


# ============================================================================
# Cache  (Settings > Cache)
# ============================================================================

# SQLite file holding cached lookups.
AO_CACHE_DB=cache.sqlite3

# Seconds to remember a *failed* lookup - a miss only means "not found today".
# Successful lookups never expire, because an author and a series index do not change.
AO_CACHE_MISS_TTL=86400

# Skip entries already resolved in a previous run.
AO_RESUME_SCANS=true


# ============================================================================
# Interface  (Settings > Interface)
# ============================================================================

# Row height in the review table: compact | normal | comfortable. Compact hides covers.
AO_UI_DENSITY=normal

# Toolbar button size: compact | normal | comfortable | large.
AO_UI_ICON_SIZE=large
AO_UI_TOOLBAR_LABELS=true

AO_UI_SHOW_COVERS=true
# Colour stripe down each row for its review status.
AO_UI_STATUS_STRIPE=true
# Also wash the whole row in its status colour. Loud - the stripe and pill already say it.
AO_UI_ROW_TINT=true
# Colour the confidence bar: red below 50%, amber below 80%, green above.
AO_UI_CONFIDENCE_COLOR=true
# Tint each field by which source produced it.
AO_UI_COLOR_BY_SOURCE=true

AO_UI_SHOW_FILTERS=true
# Show the panel explaining how the selected row was identified.
AO_UI_SHOW_PANEL=true

# How many recently-used copy actions to list directly in the right-click menu, above
# the "Copy..." submenu. 0 shows none; set it to the number of copy actions or higher
# and they are all listed and the submenu disappears.
AO_UI_COPY_RECENTS=1

# Re-sort the table as values change. Off by default: rows jumping the moment you
# approve them loses your place.
AO_UI_RESORT_LIVE=false

# Move to the next row after approving or rejecting, so reviewing flows without the mouse.
AO_UI_ADVANCE_AFTER_DECISION=true

# Ask for confirmation before applying to the filesystem.
AO_UI_CONFIRM_APPLY=true

# Reopen with the last window size and panel split.
AO_UI_REMEMBER_LAYOUT=true

# Toolbar buttons in display order; "|" is a separator, anything left out is hidden.
# Editable on Settings > Toolbar. Available ids: scan, sources, identify, approve,
# reject, reset, goodreads, preview, apply, undo, settings.
AO_TOOLBAR=scan,sources,identify,|,approve,reject,reset,|,goodreads,preview,apply,undo,|,settings

# The app also writes remembered UI state into .env - window geometry, column widths,
# hidden columns, the grid-editor layout, the copy-action MRU list. Those are not
# settings and are not listed here; they appear in your .env once the app has run:
#   AO_UI_WINDOW, AO_UI_COLUMN_WIDTHS, AO_UI_HIDDEN_COLUMNS,
#   AO_UI_GRID_WINDOW, AO_UI_GRID_COLUMNS, AO_UI_COPY_RECENT_LIST
