# User files: settings (.env), book list, cache, logs, backups
/user/

# Disposable: build intermediates, bytecode, scratch files
/src/junk/

# Built executable
/AudiobookOrganizer.exe

# Tests (kept locally, never committed)
tests/

# Internal documentation
/docs/

# Virtual environment
venv/
.venv/
venv_activate.bat
venv_update.bat

# Python leftovers, if anything runs outside launch.bat / build.bat
__pycache__/
*.py[cod]
.pytest_cache/

# Safety net: anything user-like that ends up outside user/
.env
.env.*
*.log
*.log.*
*.sqlite3
book_entries*.json
apply_journal*.jsonl

# Leftovers from the old layout
/build/
/dist/
/temp/
/logs/
/backups/
/input/
/output/

# IDE / OS
.idea/
.vscode/
.claude/
.DS_Store
Thumbs.db
